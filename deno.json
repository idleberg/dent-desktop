{
  "name": "@nsis/dent-desktop",
  "version": "0.1.0",
  "exports": "./app.ts",
  "private": true,
  "exclude": ["src/", "vite.config.ts"],
  "tasks": {
    "bundle": "deno run --allow-all npm:vite build",
    "build": {
      "command": "deno desktop --unstable-kv --allow-env --allow-read --allow-write --allow-net --include=dist --output Dent app.ts",
      "dependencies": ["bundle"]
    },
    "dev": {
      "command": "deno run --unstable-kv --allow-env --allow-read --allow-write --allow-net --watch=dist app.ts",
      "dependencies": ["bundle"]
    },
    "watch": "deno run --allow-all npm:vite build --watch",
    "serve": "deno run --allow-all npm:vite"
  },
  "imports": {
    "@codemirror/commands": "npm:@codemirror/commands@^6.10.4",
    "@codemirror/language": "npm:@codemirror/language@^6.12.4",
    "@codemirror/state": "npm:@codemirror/state@^6.7.1",
    "@codemirror/view": "npm:@codemirror/view@^6.43.7",
    "@lezer/highlight": "npm:@lezer/highlight@^1.2.3",
    "@nsis/codemirror": "npm:@nsis/codemirror@^0.13.0",
    "@nsis/dent-ui": "npm:@nsis/dent-ui@^0.2.3",
    "@sveltejs/vite-plugin-svelte": "npm:@sveltejs/vite-plugin-svelte@^7.2.0",
    "svelte": "npm:svelte@^5.56.8",
    "vite": "npm:vite@^8.1.5"
  },
  "nodeModulesDir": "auto",
  "compilerOptions": {
    "lib": ["deno.ns", "deno.unstable", "dom", "dom.iterable", "esnext"],
    "verbatimModuleSyntax": true
  },
  "desktop": {
    "app": {
      "name": "Dent",
      "identifier": "org.nsis-dev.dent"
    }
  }
}
